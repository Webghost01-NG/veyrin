# Server-only. Never expose this value in browser code.
QUICKNODE_ZCASH_URL=https://your-endpoint.zec-mainnet.quiknode.pro/your-token/

# Required for the Intent Lab. Use HTTPS in production. The packaged local
# inspector exposes its authenticated edge on loopback port 10000.
ZALLET_RPC_URL=http://127.0.0.1:10000/
ZALLET_RPC_USER=
ZALLET_RPC_PASSWORD=
